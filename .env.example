# Copy this file to .env and fill in real values. Never commit .env.

# AI synthesis
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
GOOGLE_API_KEY=
# Optional alternatives when LLM_PROVIDER is changed:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Web search
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
# Optional alternative when WEB_SEARCH_PROVIDER=serper:
SERPER_API_KEY=

# PostgreSQL. Choose a local password and use it in both values.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://researcher:YOUR_LOCAL_PASSWORD@localhost:5432/researcher
STORAGE_BACKEND=postgres

# Application behaviour
LOG_LEVEL=INFO
CACHE_TTL_SECONDS=86400
PER_SOURCE_TIMEOUT_SECONDS=10
SYNTHESIS_TIMEOUT_SECONDS=45
MAX_SOURCES_PER_QUERY=3
MAX_PARALLEL_SOURCES=3
MAX_RETRY_ATTEMPTS=3
RETRY_MIN_WAIT_SECONDS=0.25
RETRY_MAX_WAIT_SECONDS=4
ARXIV_MIN_INTERVAL_SECONDS=1
QUESTION_MAX_LENGTH=1000
HTTP_USER_AGENT="AsyncResearchAssistant/1.0 (M301; contact: your-email@example.com)"
